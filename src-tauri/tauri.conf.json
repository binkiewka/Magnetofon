{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnetofon",
  "version": "1.0.1",
  "identifier": "com.magnetofon.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Magnetofon",
        "label": "player",
        "url": "index.html#player",
        "width": 500,
        "height": 400,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      },
      {
        "title": "Playlist",
        "label": "playlist",
        "url": "index.html#playlist",
        "width": 500,
        "height": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      },
      {
        "title": "Graphic Equalizer",
        "label": "equalizer",
        "url": "index.html#equalizer",
        "width": 500,
        "height": 260,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      },
      {
        "title": "Visual Control Overlay",
        "label": "visuals",
        "url": "index.html#visuals",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../resources/projectm/**/*"]
  }
}
