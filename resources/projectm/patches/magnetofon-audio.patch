 void AudioCapture::FillBuffer()
 {
+#ifdef MAGNETOFON_HAVE_PULSE
+    if (_magnetofonCapture)
+    {
+        std::uint64_t sequence = 0;
+        const bool live = _magnetofonCapture->pcmSnapshot(_magnetofonSamples, sequence);
+        if (live && sequence != _magnetofonSequence)
+        {
+            _magnetofonSequence = sequence;
+            const auto frames = std::min<unsigned>(PulseAudioAnalyzer::kFrames, projectm_pcm_get_max_samples());
+            const auto* samples = _magnetofonSamples.data() + (PulseAudioAnalyzer::kFrames - frames) * 2;
+            projectm_pcm_add_float(_magnetofonProjectM, samples, frames, PROJECTM_STEREO);
+        }
+        if (!live)
+        {
+            // No stale energy after capture loss/pause. Silence is not claimed live.
+            std::array<float, 128> silence{};
+            projectm_pcm_add_float(_magnetofonProjectM, silence.data(), 64, PROJECTM_STEREO);
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (live != _magnetofonLive || now - _magnetofonReport >= std::chrono::seconds(1))
+        {
+            double squares = 0;
+            if (live) for (const float value : _magnetofonSamples) squares += value * value;
+            const double rms = live ? std::sqrt(squares / _magnetofonSamples.size()) : 0;
+            std::cout << "MAGNETOFON_AUDIO " << (live ? (rms < 0.000001 ? "silent" : "live") : "unavailable")
+                      << " sequence=" << sequence << " rms=" << rms << std::endl;
+            _magnetofonLive = live;
+            _magnetofonReport = now;
+        }
+        return;
+    }
+#endif
     if (!_impl)
     {
         return;
