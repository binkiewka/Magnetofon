+
+# Magnetofon uses the same process-restricted capture implementation as its meters.
+# It is provided by the enclosing application checkout, not a second decoder.
+if (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND MAGNETOFON_AUDIO_SOURCE_DIR)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(MAGNETOFON_PULSE REQUIRED IMPORTED_TARGET libpulse)
+    find_package(Threads REQUIRED)
+    target_sources(projectMSDL PRIVATE "${MAGNETOFON_AUDIO_SOURCE_DIR}/PulseAudioAnalyzer.cpp")
+    target_compile_features(projectMSDL PRIVATE cxx_std_17)
+    target_include_directories(projectMSDL PRIVATE "${MAGNETOFON_AUDIO_SOURCE_DIR}")
+    target_compile_definitions(projectMSDL PRIVATE MAGNETOFON_HAVE_PULSE)
+    target_link_libraries(projectMSDL PRIVATE PkgConfig::MAGNETOFON_PULSE Threads::Threads)
+endif ()
